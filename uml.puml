
@startuml
skinparam classAttributeIconSize 0
left to right direction

' ==========================================
' PAQUETE: BITÁCORA (Singleton)
' ==========================================
package modelo.bitacora {
    class Bitacora <<Singleton>> {
        - static Bitacora instancia
        - ArrayList<String> registro
        - Bitacora()
        + static Bitacora getInstance()
        + void registrar(evento: String)
        + ArrayList<String> getRegistro()
    }
}

' ==========================================
' PAQUETE: MOTOR WARP (Patrón State)
' ==========================================
package modelo.motorWarp {
    interface State <<interface>> {
        + void prepararSalto()
        + void entrarEnWarp()
        + void iniciarEnfriamiento()
        + void volverADisponible()
    }

    class MotorWarp {
        - State state
        + MotorWarp()
        + void setState(state: State)
        + State getState()
        + void prepararSalto()
        + void entrarEnWarp()
        + void iniciarEnfriamiento()
        + void volverAlDisponible()
        + boolean estaDisponible()
        + boolean estaPreparando()
        + boolean estaEnEnfriamiento()
    }

    class Disponible {
        - MotorWarp motorWarp
        + Disponible(motor: MotorWarp)
        + void prepararSalto()
        + void entrarEnWarp()
        + void iniciarEnfriamiento()
        + void volverAlDisponible()
    }

    class PreparandoSalto {
        - MotorWarp motorWarp
        + PreparandoSalto(motor: MotorWarp)
        + void prepararSalto()
        + void entrarEnWarp()
        + void iniciarEnfriamiento()
        + void volverAlDisponible()
    }

    class EnWarp {
        - MotorWarp motorWarp
        + EnWarp(motor: MotorWarp)
        + void prepararSalto()
        + void entrarEnWarp()
        + void iniciarEnfriamiento()
        + void volverAlDisponible()
    }

    class Enfriamento {
        - MotorWarp motorWarp
        + Enfriamento(motor: MotorWarp)
        + void prepararSalto()
        + void entrarEnWarp()
        + void iniciarEnfriamiento()
        + void volverAlDisponible()
    }
}

' ==========================================
' PAQUETE: SENSORES Y NAVEGACIÓN
' ==========================================
package modelo.sensores {
    class Sensores {
        - Tablero tablero
        + Sensores(tablero: Tablero)
        + ElementoDelUniverso[] escanearCortoAlcance()
        + ElementoDelUniverso[] escanearLargoAlcance()
    }

    class ReglasNavegacion {
        - Sensores sensores
        + ReglasNavegacion(sensores: Sensores)
        + void evaluarYEjecutarPaso(nave: Nave, destino: Posicion)
        - boolean intentarPasoOrtogonal(nave: Nave, deltaX: int, deltaY: int)
        - void realizarSaltoNormal(nave: Nave, deltaX: int, deltaY: int)
        - boolean realizarSaltoWarp(nave: Nave, deltaX: int, deltaY: int)
        + Sensores getSensores()
    }
}

' ==========================================
' PAQUETE: DESTINO Y TABLERO / ELEMENTOS
' ==========================================
package modelo.destinoytablero {
    abstract class Observable <<abstract>> {
        + void agregarObservador(o: Object)
        + void notificarObservadores()
    }

    class Tablero {
        - int x
        - int y
        - HashMap<Posicion, ElementoDelUniverso> ocupacion
        - Posicion posicionNave
        - Posicion objetivo
        + Tablero(x: int, y: int, elementos: ArrayList<ElementoDelUniverso>)
        + Posicion getPosicionNave()
        + void moverNave(posicion: Posicion)
        + ElementoDelUniverso inspeccionarPosicion()
        + ElementoDelUniverso[][] observarAlrededores()
        + ElementoDelUniverso[][] verTablero()
    }

    class Destino {
        - Tablero tablero
        + Destino(tablero: Tablero)
        + void turnoDestino()
    }

    class Posicion {
        - int x
        - int y
        + Posicion(x: int, y: int)
        + int getX()
        + int getY()
        + boolean equals(obj: Object)
        + int hashCode()
    }
}

package modelo.elementos {
    interface ElementoDelUniverso <<interface>> {
        + void interactuar(nave: Nave)
    }

    class Asteroide
    class EstacionDeCarga
    class Anomalia
    class Gema
}

' ==========================================
' PAQUETE: NAVE (Factory + Double Dispatch)
' ==========================================
package modelo.nave {
    abstract class Nave <<abstract>> {
        - static final int CAPACIDAD_COMBUSTIBLE = 100
        - static final int CAPACIDAD_ENERGIA = 100
        - static final int DESGASTE_MAXIMO = 100
        - static final int UMBRAL_MANTENIMIENTO = 80
        - static final int TRIPULACION_MINIMA = 5
        - final int id
        - int combustible
        - int energia
        - int desgaste
        - boolean destruida
        - Posicion posicion
        - final ArrayList<Tripulante> tripulacion
        - final MotorWarp motorWarp
        # Nave(id: int, combustible: int, energia: int)
        + int getId()
        + int getCombustible()
        + int getEnergia()
        + int getDesgaste()
        + boolean estaDestruida()
        + Posicion getPosicion()
        + void setPosicion(posicion: Posicion)
        + MotorWarp getMotorWarp()
        + void descontarCombustible(cant: int)
        + void descontarEnergia(cant: int)
        + void generarDesgaste(cant: int)
        + void realizarMantenimiento()
        + void destruir()
        + void agregarTripulante(t: Tripulante)
        + boolean tieneTripulacionValida()
        + void interactuar(naveJugador: Nave)
        + ResultadoCombate enfrentar(rival: Nave)
        # abstract ResultadoCombate recibirEncuentroDe(navePropia: NaveExploradora)
        # abstract ResultadoCombate recibirEncuentroDe(navePropia: NaveCarguero)
        # abstract ResultadoCombate recibirEncuentroDe(navePropia: NaveCombate)
    }

    class NaveCarguero {
        + NaveCarguero(id: int)
    }
    class NaveCombate {
        + NaveCombate(id: int)
    }
    class NaveExploradora {
        + NaveExploradora(id: int)
    }

    class NaveFactory {
        - NaveFactory()
        + static Nave crearNave(tipo: TipoNave, id: int)
    }

    enum TipoNave {
        CARGUERO
        COMBATE
        EXPLORADORA
    }

    enum ResultadoCombate {
        GANA
        PIERDE
        PACTO_DE_PAZ
    }
}

' ==========================================
' PAQUETE: ASISTENTE DE COMANDOS (Mediador)
' ==========================================
package modelo.asistenteDeComandos {
    class AsistenteDeComandos {
        - Nave nave
        - Bitacora bitacora
        - Tablero tablero
        - Destino destino
        - ReglasNavegacion reglas
        - Posicion base
        + AsistenteDeComandos(nave: Nave, bitacora: Bitacora)
        + AsistenteDeComandos(nave: Nave, bitacora: Bitacora, tablero: Tablero)
        + void setTablero(tablero: Tablero)
        + void setReglasNavegacion(reglas: ReglasNavegacion)
        + void avanzarHacia(destinoFinal: Posicion)
        + void interactuarCon(elemento: ElementoDelUniverso)
        + void registrarEvento(evento: String)
        + Nave getNave()
    }
}

' ==========================================
' PAQUETE: MISIONES (Template Method)
' ==========================================
package modelo.misiones {
    abstract class Mision <<abstract>> {
        # AsistenteDeComandos AC
        # ResultadoMision resultado
        # InformeMision informe
        + Mision(AC: AsistenteDeComandos)
        + final boolean director()
        # abstract void evalar()
        # abstract boolean ejecutar()
        # boolean preparar()
        # void cerrar()
        + InformeMision getInforme()
        # abstract int getCombustibleRequerido()
        # abstract int getEnergiaRequerida()
        # abstract int getDesgasteGenerado()
    }

    class Intercepcion {
        - int energiaRequerida
        - int combustibleRequerido
        - int desgaste
        + Intercepcion(AC: AsistenteDeComandos, combustible: int, energia: int, desgaste: int)
        # int getCombustibleRequerido()
        # int getEnergiaRequerida()
        # int getDesgasteGenerado()
        # boolean ejecutar()
        # void evalar()
    }
    class Recoleccion {
        - int energiaRequerida
        - int combustibleRequerido
        - int desgaste
        + Recoleccion(AC: AsistenteDeComandos, combustible: int, energia: int, desgaste: int)
        # int getCombustibleRequerido()
        # int getEnergiaRequerida()
        # int getDesgasteGenerado()
        # boolean ejecutar()
        # void evalar()
    }
    class Retorno {
        - int energiaRequerida
        - int combustibleRequerido
        - int desgaste
        + Retorno(AC: AsistenteDeComandos, combustible: int, energia: int, desgaste: int)
        # int getCombustibleRequerido()
        # int getEnergiaRequerida()
        # int getDesgasteGenerado()
        # boolean ejecutar()
        # void evalar()
    }

    enum ResultadoMision {
        EXITOSA
        FALLIDA
    }

    class InformeMision {
        - final String misionEjecutada
        - final ResultadoMision resultado
        - final List<String> acionesPrincipales
        - final String recursosConsumidos
        - final String estadoNave
        - final String observaciones
        + InformeMision(...)
        + String toString()
    }
}

' ==========================================
' PAQUETE: TRIPULACIÓN (Decorator)
' ==========================================
package modelo.Tripulacion {
    abstract class Tripulante <<abstract>> {
        # Identidad identidad
        # String cargo
        # double antiguedad
        # String origen
        # double sueldob
        + Tripulante(id: Identidad, ant: double)
        + abstract double getSueldo()
        + String getID()
        + String getCargo()
        + double getAntiguedad()
        + String getOrigen()
    }

    class Identidad {
        - static int sig
        - int id
        - String nombre
        + Identidad(nombre: String)
        + String getNombre()
    }

    interface Haber <<interface>> {
        + double getSueldo()
    }

    class Capitan {
        - static Capitan instancia
        - AsistenteDeComandos ANav
        - double sueldob
        - double bonusant
        + Capitan(id: Identidad, ant: double, anav: AsistenteDeComandos)
        + double getSueldo()
        + static Capitan getInstancia()
    }

    class Consejero {
        - double sueldob
        - double bonusant
        - ArrayList<String> Lconsejos
        + Consejero(id: Identidad, ant: double)
        + double getSueldo()
    }

    class Teniente {
        - double sueldob
        - double bonusant
        + Teniente(id: Identidad, ant: double)
        + double getSueldo()
    }

    class Alferez {
        - double sueldob
        - double bonusant
        + Alferez(id: Identidad, ant: double)
        + double getSueldo()
    }

    abstract class DecoratorPlaneta <<abstract>> {
        - Haber haber
        # Tripulante tripulante
        + DecoratorPlaneta(t: Tripulante)
    }

    class Marciano {
        - final double subsidio
        + Marciano(haber: Haber)
        + double getSueldo()
    }

    class Terricola {
        - final double subsidio
        + Terricola(haber: Haber)
        + double getSueldo()
    }

    class Vulcano {
        - final double subsidio
        + Vulcano(haber: Haber)
        + double getSueldo()
    }
}

' ==========================================
' RELACIONES Y DEPENDENCIAS
' ==========================================

' State (Motor Warp)
MotorWarp o-- State : estado
State <|.. Disponible
State <|.. PreparandoSalto
State <|.. EnWarp
State <|.. Enfriamento

' Factory & Double Dispatch & ElementoDelUniverso
Nave <|-- NaveCarguero
Nave <|-- NaveCombate
Nave <|-- NaveExploradora
ElementoDelUniverso <|.. Nave
NaveFactory ..> Nave : crea
NaveFactory ..> TipoNave : usa
Nave *-- MotorWarp : contiene
Nave ..> Posicion : se posiciona en

' Sensores & Navegación
Sensores ..> Tablero : lee vecindario
ReglasNavegacion o-- Sensores : usa
ReglasNavegacion ..> Nave : navega / salta
ReglasNavegacion ..> Posicion : evalua coordenadas

' Tablero y Elementos
Observable <|-- Tablero
Tablero o-- Posicion : grilla
Tablero o-- ElementoDelUniverso : contiene
Destino o-- Tablero : mueve elementos
ElementoDelUniverso <|.. Asteroide
ElementoDelUniverso <|.. EstacionDeCarga
ElementoDelUniverso <|.. Anomalia
ElementoDelUniverso <|.. Gema

' AsistenteDeComandos (Mediador)
AsistenteDeComandos o-- Nave : coordina
AsistenteDeComandos o-- Bitacora : registra
AsistenteDeComandos o-- Tablero : actualiza
AsistenteDeComandos o-- ReglasNavegacion : delega paso
AsistenteDeComandos ..> Mision : ejecuta

' Template Method (Misiones)
Mision <|-- Intercepcion
Mision <|-- Recoleccion
Mision <|-- Retorno
Mision *-- InformeMision : produce
Mision *-- ResultadoMision : genera
Mision ..> Bitacora : registra

' Decorator (Tripulación)
Tripulante <|.. Capitan
Tripulante <|.. Consejero
Tripulante <|.. Teniente
Tripulante <|.. Alferez
Tripulante <|.. DecoratorPlaneta
Tripulante *-- Identidad : tiene
DecoratorPlaneta o-- Tripulante : envuelve
DecoratorPlaneta <|-- Marciano
DecoratorPlaneta <|-- Terricola
DecoratorPlaneta <|-- Vulcano
Nave *-- Tripulante : tripulacion

@enduml