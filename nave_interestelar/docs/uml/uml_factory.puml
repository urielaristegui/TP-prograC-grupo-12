@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam style strictuml

enum TipoNave <<enum>> {
    CARGUERO
    COMBATE
    EXPLORADORA
}

class NaveFactory <<Factory>> {
    - NaveFactory()
    + {static} crearNave(tipo: TipoNave, id: int): Nave
}

abstract class Nave <<Producto>> {
    - id: int
    - combustible: int
    - energia: int
    # Nave(id: int, combustible: int, energia: int)
    + getId(): int
    + getCombustible(): int
    + getEnergia(): int
}

class NaveCarguero <<ConcreteProduct>> extends Nave {
    ~ NaveCarguero(id: int)
}

class NaveCombate <<ConcreteProduct>> extends Nave {
    ~ NaveCombate(id: int)
}

class NaveExploradora <<ConcreteProduct>> extends Nave {
    ~ NaveExploradora(id: int)
}

NaveFactory ..> Nave : crea / instancia
NaveFactory ..> TipoNave : usa
@enduml