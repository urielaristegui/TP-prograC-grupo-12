@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam style strictuml
skinparam packageStyle rect

package "1. modelo.nave (Factory & Double Dispatch)" {

    enum TipoNave <<enum>> {
        CARGUERO
        COMBATE
        EXPLORADORA
    }

    class NaveFactory <<Factory>> {
        - NaveFactory()
        + {static} crearNave(tipo: TipoNave, id: int): Nave
    }

    interface ElementoDelUniverso <<interface>> {
        + interactuar(nave: Nave): void
    }

    enum ResultadoCombate <<enum>> {
        GANA
        PIERDE
        PACTO_DE_PAZ
    }

    abstract class Nave <<abstract>> implements ElementoDelUniverso {
        - id: int
        - combustible: int
        - energia: int
        - motorWarp: MotorWarp
        - tripulacion: List<Tripulante>
        # Nave(id: int, combustible: int, energia: int)
        + getId(): int
        + getCombustible(): int
        + getEnergia(): int
        + getMotorWarp(): MotorWarp
        + agregarTripulante(t: Tripulante): void
        + interactuar(naveJugador: Nave): void
        + {abstract} enfrentar(rival: Nave): ResultadoCombate
        # {abstract} recibirEncuentroDe(navePropia: NaveExploradora): ResultadoCombate
        # {abstract} recibirEncuentroDe(navePropia: NaveCarguero): ResultadoCombate
        # {abstract} recibirEncuentroDe(navePropia: NaveCombate): ResultadoCombate
    }

    class NaveExploradora <<ConcreteProduct>> extends Nave {
        ~ NaveExploradora(id: int)
        + enfrentar(rival: Nave): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveExploradora): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveCarguero): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveCombate): ResultadoCombate
    }

    class NaveCarguero <<ConcreteProduct>> extends Nave {
        ~ NaveCarguero(id: int)
        + enfrentar(rival: Nave): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveExploradora): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveCarguero): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveCombate): ResultadoCombate
    }

    class NaveCombate <<ConcreteProduct>> extends Nave {
        ~ NaveCombate(id: int)
        + enfrentar(rival: Nave): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveExploradora): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveCarguero): ResultadoCombate
        # recibirEncuentroDe(navePropia: NaveCombate): ResultadoCombate
    }
}

package "2. modelo.motorWarp (Patrón State)" {

    interface State <<interface>> {
        + prepararSalto(): void
        + entrarEnWarp(): void
        + iniciarEnfriamiento(): void
        + volverADisponible(): void
    }

    class MotorWarp <<Context>> {
        - state: State
        - turnosPreparacion: int
        - turnosEnfriamiento: int
        + MotorWarp()
        + setState(state: State): void
        + getState(): State
        + prepararSalto(): void
        + entrarEnWarp(): void
        + iniciarEnfriamiento(): void
        + volverAlDisponible(): void
        + estaDisponible(): boolean
        + estaPreparando(): boolean
        + estaEnEnfriamiento(): boolean
        + estaListoParaSaltar(): boolean
    }

    class Disponible <<ConcreteState>> implements State {
        - motorWarp: MotorWarp
        + Disponible(motorWarp: MotorWarp)
        + prepararSalto(): void
        + entrarEnWarp(): void
        + iniciarEnfriamiento(): void
        + volverADisponible(): void
    }

    class PreparandoSalto <<ConcreteState>> implements State {
        - motorWarp: MotorWarp
        + PreparandoSalto(motorWarp: MotorWarp)
        + prepararSalto(): void
        + entrarEnWarp(): void
        + iniciarEnfriamiento(): void
        + volverADisponible(): void
    }

    class EnWarp <<ConcreteState>> implements State {
        - motorWarp: MotorWarp
        + EnWarp(motorWarp: MotorWarp)
        + prepararSalto(): void
        + entrarEnWarp(): void
        + iniciarEnfriamiento(): void
        + volverADisponible(): void
    }

    class Enfriamento <<ConcreteState>> implements State {
        - motorWarp: MotorWarp
        + Enfriamento(motorWarp: MotorWarp)
        + prepararSalto(): void
        + entrarEnWarp(): void
        + iniciarEnfriamiento(): void
        + volverADisponible(): void
    }
}

package "3. modelo.Tripulacion (Patrón Decorator)" {

    interface Haber <<interface>> {
        + getSueldo(): double
    }

    abstract class Tripulante <<Componente>> implements Haber {
        # identidad: Identidad
        # ant: double
        + {abstract} getSueldo(): double
    }

    abstract class DecoratorPlaneta <<Decorator>> implements Haber {
        - haber: Haber
        + getHaber(): Haber
        + setHaber(haber: Haber): void
    }

    class Marciano <<ConcreteDecorator>> extends DecoratorPlaneta {
        - subsidio: double
        + Marciano(haber: Haber)
        + getSueldo(): double
    }

    class Terricola <<ConcreteDecorator>> extends DecoratorPlaneta {
        - subsidio: double
        + Terricola(haber: Haber)
        + getSueldo(): double
    }

    class Vulcano <<ConcreteDecorator>> extends DecoratorPlaneta {
        - subsidio: double
        + Vulcano(haber: Haber)
        + getSueldo(): double
    }

    class Capitan <<ConcreteComponent>> extends Tripulante
    class Teniente <<ConcreteComponent>> extends Tripulante
    class Consejero <<ConcreteComponent>> extends Tripulante
    class Alferez <<ConcreteComponent>> extends Tripulante
}

package "4. modelo.misiones (Patrón Template Method)" {

    abstract class Mision {
        # AC: AsistenteDeComandos
        # resultado: ResultadoMision
        # informe: InformeMision
        + Mision(AC: AsistenteDeComandos)
        + final director(): boolean <<Template Method>>
        # preparar(): boolean
        # {abstract} getCombustibleRequerido(): int
        # {abstract} getEnergiaRequerida(): int
        # {abstract} getDesgasteGenerado(): int
        # {abstract} definirObjetivo(): Posicion
        # {abstract} verificarEnDestino(): boolean
        # {abstract} aplicarCierre(): void
        # {abstract} describirCierre(): String
        + getInforme(): InformeMision
    }

    class Intercepcion extends Mision
    class Recoleccion extends Mision
    class Retorno extends Mision
}

package "5. modelo.UniversoAlterno (Monitores / Concurrencia)" {

    class PlataformaDeCarga <<Monitor>> {
        - bateriasDisponibles: int
        - capacidadMaxima: int
        + synchronized depositarBateria(generadoraId: String): void
        + synchronized retirarBateria(naveId: String): void
    }

    class GeneradoraDeEnergia <<Productor>> implements java.lang.Runnable {
        - plataforma: PlataformaDeCarga
        + run(): void
    }

    class NaveConsumidora <<Consumidor>> implements java.lang.Runnable {
        - plataforma: PlataformaDeCarga
        + run(): void
    }
}

package "6. modelo.Persistencia (DAO & DTO)" {

    class UsuarioDTO <<DTO>> {
        - nombreUsuario: String
        - contrasena: String
    }

    interface UsuarioDAO <<interface>> {
        + registrar(usuario: UsuarioDTO): boolean
        + autenticar(nombreUsuario: String, contrasena: String): boolean
    }

    class ArchivoUsuarioDao implements UsuarioDAO {
        - archivoUsuarios: Path
    }

    class AutenticacionService {
        - usuarioDAO: UsuarioDAO
        - usuarioActual: UsuarioDTO
    }
}

package "7. modelo.asistenteDeComandos (Fachada & Coordinación)" {

    class AsistenteDeComandos {
        - nave: Nave
        - bitacora: Bitacora
        - tablero: Tablero
        - reglas: ReglasNavegacion
    }

    class Bitacora <<Singleton>>
    class Tablero
    class ReglasNavegacion
}

' =========================================================
' CONEXIONES INTER-PAQUETES (EL NÚCLEO DEL DIAGRAMA)
' =========================================================

' Conexiones principales de Nave con los patrones:
Nave --> "1" MotorWarp : posee (State)
Nave o--> "*" Tripulante : posee (Decorator)
NaveFactory ..> Nave : crea (Factory)
Nave ..> ResultadoCombate : resuelve (Double Dispatch)

' Conexiones de Concurrencia:
GeneradoraDeEnergia --> "1" PlataformaDeCarga : deposita en
NaveConsumidora --> "1" PlataformaDeCarga : retira de
NaveConsumidora --> "1" Nave : consume energía para

' Conexiones de Persistencia:
ArchivoUsuarioDao ..|> UsuarioDAO : implementa
AutenticacionService --> "1" UsuarioDAO : usa (DIP)
AutenticacionService o--> "0..1" UsuarioDTO : gestiona
UsuarioDAO ..> UsuarioDTO : transfiere

' Conexiones del Asistente y Misiones:
AsistenteDeComandos --> "1" Nave : coordina
AsistenteDeComandos --> "1" Bitacora : registra eventos
Mision --> "1" AsistenteDeComandos : ejecuta comandos sobre

@enduml