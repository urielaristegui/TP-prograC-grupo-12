@startuml
skinparam classAttributeIconSize 0


  enum ResultadoMision {
    EXITOSA
    FALLIDA
  }

  class InformeMision {
    - misionEjecutada : String
    - resultado : ResultadoMision
    - accionesPrincipales : List<String>
    - recursosConsumidos : String
    - estadoNave : String
    - observaciones : String
    + InformeMision(misionEjecutada : String,
    resultado : ResultadoMision,
    accionesPrincipales : List<String>,
    recursosConsumidos : String, estadoNave : String,
    observaciones : String)
    + toString() : String
  }

  abstract class Mision {
    # AC : AsistenteDeComandos
    # resultado : ResultadoMision
    # informe : InformeMision
    - acciones : List<String>
    - ruta : List<Posicion>
    - recorrido : List<Posicion>
    - objetivo : Posicion
    - llegoAlDestino : boolean
    - motivoFallo : String
    - combustibleInicial : int
    - energiaInicial : int
    - desgasteInicial : int
    + Mision(AC : AsistenteDeComandos)
    + {final} director() : boolean
    # preparar() : boolean
    # ejecutar() : void
    # evaluar() : ResultadoMision
    # cerrar() : void
    # registrar(accion : String) : void
    # {abstract} definirObjetivo() : Posicion
    # {abstract} verificarEnDestino() : boolean
    # {abstract} aplicarCierre() : void
    # {abstract} describirCierre() : String
  }

  class Intercepcion {
    - combustibleSolicitado : int
    - energiaSolicitada : int
    + Intercepcion(AC : AsistenteDeComandos,
    combustibleSolicitado : int, energiaSolicitada : int)

  }

  class Recoleccion {
    - gemas : int
    + Recoleccion(AC : AsistenteDeComandos)
    + Recoleccion(AC : AsistenteDeComandos, gemas : int)

  }

  class Retorno {
    + Retorno(AC : AsistenteDeComandos)
  }

  Mision <|-- Intercepcion
  Mision <|-- Recoleccion
  Mision <|-- Retorno

  Mision --> ResultadoMision : resultado
  InformeMision --> ResultadoMision : resultado
  Mision ..> InformeMision : genera


  class AsistenteDeComandos

  class Posicion

Mision --> AsistenteDeComandos : AC
Mision --> Posicion
Intercepcion ..> Posicion : usa
Recoleccion ..> Posicion : usa
Retorno ..> Posicion : usa

@enduml